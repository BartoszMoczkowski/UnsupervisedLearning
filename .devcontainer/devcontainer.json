{
  "name": "unsupervised-learning",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "runArgs": ["--gpus", "all", "--ipc=host"],
  "mounts": [
    "source=ul-venv,target=/workspaces/UnsupervisedLearning/.venv,type=volume",
    "source=${localEnv:UL_DATA_DIR},target=/data,type=bind"
  ],
  "containerEnv": {
    "TRAINING_DATA_DIR": "/data/wikiart-parquet"
  },
  "remoteUser": "unsupervised",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/UnsupervisedLearning/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": ["uv", "sync"]
}